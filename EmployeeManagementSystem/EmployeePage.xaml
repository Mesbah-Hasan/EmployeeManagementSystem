<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    x:Class="EmployeeManagementSystem.EmployeePage"
    Title="Employee">

    <VerticalStackLayout
        Padding="20"
        Spacing="20">

        <Label
            Text="Employee Page"
            FontSize="30"
            FontAttributes="Bold"
            HorizontalOptions="Center"/>

        <Button
            Text="Go To Designation"
            Clicked="GoToDesignation"/>

    </VerticalStackLayout>

</ContentPage>