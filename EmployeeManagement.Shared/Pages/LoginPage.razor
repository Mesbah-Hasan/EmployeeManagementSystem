@page "/login"
@inject HttpClient Http
@inject NavigationManager Nav
@inject EmployeeManagement.Shared.Services.AuthState Auth
@using EmployeeManagement.Shared.Models
@using System.Net.Http.Json
@layout EmployeeManagement.Shared.Layout.BlankLayout

<h3>লগইন</h3>

@if (message != null)
{
    <p style="color:red;">@message</p>
}

<EditForm Model="loginModel" OnValidSubmit="HandleLogin">
    <table>
        <tr>
            <td>ইউজারনেম</td>
            <td><InputText @bind-Value="loginModel.Username" /></td>
        </tr>
        <tr>
            <td>পাসওয়ার্ড</td>
            <td><InputText type="password" @bind-Value="loginModel.Password" /></td>
        </tr>
    </table>
    <button type="submit">Login</button>
</EditForm>

<p>অ্যাকাউন্ট নেই? <a href="/register">Register?</a></p>

@code {
    private LoginRequest loginModel = new();
    private string? message;

    public class LoginRequest
    {
        public string Username { get; set; } = string.Empty;
        public string Password { get; set; } = string.Empty;
    }

    public class LoginResponse
    {
        public bool Success { get; set; }
        public string Message { get; set; } = string.Empty;
        public string? FullName { get; set; }
        public string? Username { get; set; }
    }

    private async Task HandleLogin()
    {
        try
        {
            var response = await Http.PostAsJsonAsync("api/users/login", loginModel);
            var result = await response.Content.ReadFromJsonAsync<LoginResponse>();

            if (result != null && result.Success)
            {
                Auth.SetUser(result.Username!, result.FullName!);
                Nav.NavigateTo("/");
            }
            else
            {
                message = result?.Message ?? "লগইন ব্যর্থ হয়েছে।";
            }
        }
        catch (Exception ex)
        {
            message = ex.Message;
        }
    }
}