@inject EmployeeManagement.Shared.Services.AuthState Auth
@inject NavigationManager Nav

<div class="top-row ps-3 navbar navbar-dark">
    <div class="container-fluid">
        <a class="navbar-brand" href="">
            Employee Management
        </a>
    </div>
</div>

<input type="checkbox"
       title="Navigation menu"
       class="navbar-toggler" />

<div class="nav-scrollable"
     onclick="document.querySelector('.navbar-toggler').click()">

    <nav class="nav flex-column">

        @if (Auth.IsLoggedIn)
        {
            <div class="nav-item px-3" style="color:white;">
                স্বাগতম, @Auth.FullName
            </div>
            <div class="nav-item px-3">
                <a class="nav-link" href="#" @onclick="HandleLogout" @onclick:preventDefault="true">
                    Logout
                </a>
            </div>
        }

        <div class="nav-item px-3">
            <NavLink class="nav-link"
                     href=""
                     Match="NavLinkMatch.All">
                <span class="bi bi-house-door-fill-nav-menu"></span>
                Home
            </NavLink>
        </div>

        <div class="nav-item px-3">
            <NavLink class="nav-link"
                     href="employee">
                <span class="bi bi-plus-square-fill-nav-menu"></span>
                Employee
            </NavLink>
        </div>

        <div class="nav-item px-3">
            <NavLink class="nav-link"
                     href="designation">
                <span class="bi bi-list-nested-nav-menu"></span>
                Designation
            </NavLink>
        </div>

        <div class="nav-item px-3">
            <NavLink class="nav-link"
                     href="salary">
                <span class="bi bi-list-nested-nav-menu"></span>
                Salary
            </NavLink>
        </div>

        <div class="nav-item px-3">
            <NavLink class="nav-link"
                     href="items">
                <span class="bi bi-list-nested-nav-menu"></span>
                Items
            </NavLink>
        </div>

        <div class="nav-item px-3">
            <NavLink class="nav-link"
                     href="complaints">
                <span class="bi bi-list-nested-nav-menu"></span>
                অভিযোগ ব্যবস্থাপনা
            </NavLink>
        </div>

    </nav>

</div>

@code {
    private void HandleLogout()
    {
        Auth.Logout();
        Nav.NavigateTo("/login");
    }
}